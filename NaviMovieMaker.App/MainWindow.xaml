<Window x:Class="NaviMovieMaker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:NaviMovieMaker.App.Services"
        mc:Ignorable="d"
        Title="NaviMovie-Maker" Height="860" Width="1280" MinHeight="760" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Icon="pack://application:,,,/Assets/app.ico">
    <Window.Resources>
        <Style x:Key="LogMarkerStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="●" />
            <Setter Property="Foreground" Value="#2563EB" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:LogLevel.Warn}">
                    <Setter Property="Text" Value="⚠" />
                    <Setter Property="Foreground" Value="#D97706" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:LogLevel.Error}">
                    <Setter Property="Text" Value="✖" />
                    <Setter Property="Foreground" Value="#DC2626" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:LogLevel.Success}">
                    <Setter Property="Text" Value="✓" />
                    <Setter Property="Foreground" Value="#16A34A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:LogLevel.Debug}">
                    <Setter Property="Text" Value="·" />
                    <Setter Property="Foreground" Value="#6B7280" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogLevelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1D4ED8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:LogLevel.Warn}">
                    <Setter Property="Foreground" Value="#B45309" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:LogLevel.Error}">
                    <Setter Property="Foreground" Value="#B91C1C" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:LogLevel.Success}">
                    <Setter Property="Foreground" Value="#15803D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static services:LogLevel.Debug}">
                    <Setter Property="Foreground" Value="#6B7280" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConversionQueueRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUnsupported}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    <Setter Property="FontStyle" Value="Italic" />
                    <Setter Property="ToolTip" Value="{Binding UnsupportedReason}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Menu Margin="0,0,0,14">
                <MenuItem Header="_ツール">
                    <MenuItem x:Name="CheckExternalToolsMenuItem"
                              Header="外部ツール確認"
                              Click="CheckExternalToolsMenuItem_Click" />
                    <MenuItem x:Name="InstallExternalToolsMenuItem"
                              Header="外部ツールを自動取得"
                              Click="InstallExternalToolsMenuItem_Click" />
                    <MenuItem Header="tools フォルダを開く"
                              Click="OpenToolsFolderMenuItem_Click" />
                    <Separator />
                    <MenuItem x:Name="SettingsMenuItem"
                              Header="設定"
                              Click="SettingsMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="作業フォルダを開く"
                              Click="OpenWorkingFolderMenuItem_Click" />
                    <MenuItem Header="変換済みフォルダを開く"
                              Click="OpenConvertedFolderMenuItem_Click" />
                    <MenuItem Header="一時フォルダを開く"
                              Click="OpenTemporaryFolderMenuItem_Click" />
                    <MenuItem Header="ローカル動画フォルダを開く"
                              Click="OpenLocalVideoFolderMenuItem_Click" />
                </MenuItem>
            </Menu>
            <TextBlock x:Name="ExternalToolsStatusTextBlock"
                       Text="External tools: Check required"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <CheckBox x:Name="SimpleModeCheckBox"
                      Content="Simple Mode"
                      VerticalAlignment="Center"
                      Margin="0,10,0,0"
                      Checked="SimpleModeCheckBox_CheckedChanged"
                      Unchecked="SimpleModeCheckBox_CheckedChanged" />
            <GroupBox x:Name="SimpleModePanel"
                      Header="Simple Mode"
                      Margin="0,8,0,0"
                      Visibility="Collapsed">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="SimpleOutputPresetComboBox"
                              Grid.Column="0"
                              ToolTip="Simple Modeで使う出力形式を選びます。"
                              MinHeight="30"
                              Margin="0,0,12,0"
                              SelectionChanged="SimpleOutputPresetComboBox_SelectionChanged" />
                    <Border Grid.Column="1"
                            x:Name="SimpleModeDropArea"
                            AllowDrop="True"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,6"
                            Margin="0,0,12,0"
                            DragOver="SimpleModeDropArea_DragOver"
                            Drop="SimpleModeDropArea_Drop">
                        <TextBlock x:Name="SimpleModeStatusTextBlock"
                                   Text="URL またはローカルファイルをここへドロップ"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    </Border>
                    <Button x:Name="SimpleCancelQueueButton"
                            Grid.Column="2"
                            Content="キャンセル"
                            ToolTip="現在実行中の処理を中断します。"
                            IsEnabled="False"
                            MinWidth="100"
                            MinHeight="30"
                            Margin="0,0,8,0"
                            Click="SimpleCancelQueueButton_Click" />
                    <Button Grid.Column="3"
                            Content="変換済みフォルダ"
                            MinWidth="130"
                            MinHeight="30"
                            Click="OpenConvertedFolderMenuItem_Click" />
                </Grid>
            </GroupBox>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="VideoListWorkRow" Height="*" MinHeight="150" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="QueueWorkRow" Height="*" MinHeight="150" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="LogWorkRow" Height="Auto" MinHeight="0" />
            </Grid.RowDefinitions>

            <Expander x:Name="CandidatesExpander"
                      Grid.Row="0"
                      Header="動画ソース (0)"
                      IsExpanded="True"
                      Margin="0,0,0,8"
                      Expanded="CandidatesExpander_Expanded"
                      Collapsed="CandidatesExpander_Collapsed">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="動画ソース" Margin="0,0,0,10">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="YouTubeSearchModeRadioButton"
                                             Content="検索"
                                             ToolTip="検索語で動画候補を取得します。現在はYouTube検索を使用します。"
                                             IsChecked="True"
                                             VerticalAlignment="Center"
                                             Checked="SourceModeRadioButton_Checked" />
                                <RadioButton x:Name="DirectUrlModeRadioButton"
                                             Content="URL指定"
                                             ToolTip="動画URLやプレイリストURLを直接指定します。yt-dlp対応サイトで動作する場合があります。"
                                             Margin="18,0,0,0"
                                             VerticalAlignment="Center"
                                             Checked="SourceModeRadioButton_Checked" />
                            </StackPanel>

                            <Grid x:Name="DirectUrlInputGrid" Grid.Row="1" Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="動画URL"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <TextBox x:Name="UrlTextBox"
                                         Grid.Column="1"
                                         AllowDrop="True"
                                         MinHeight="32"
                                         VerticalContentAlignment="Center"
                                         KeyDown="VideoSourceInputTextBox_KeyDown"
                                         DragOver="VideoSourceInputTextBox_DragOver"
                                         Drop="VideoSourceInputTextBox_Drop"
                                         ToolTip="動画URLやプレイリストURLを直接指定します。yt-dlp対応サイトで動作する場合があります。" />
                            </Grid>

                            <Grid x:Name="YouTubeSearchInputGrid" Grid.Row="1" Grid.Column="0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="検索語"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <TextBox x:Name="SearchQueryTextBox"
                                         Grid.Column="1"
                                         AllowDrop="True"
                                         MinHeight="32"
                                         VerticalContentAlignment="Center"
                                         KeyDown="VideoSourceInputTextBox_KeyDown"
                                         DragOver="VideoSourceInputTextBox_DragOver"
                                         Drop="VideoSourceInputTextBox_Drop"
                                         ToolTip="検索語で動画候補を取得します。現在はYouTube検索を使用します。" />
                                <TextBlock Grid.Column="2"
                                           Text="検索結果"
                                           VerticalAlignment="Center"
                                           Margin="12,0,8,0" />
                                <ComboBox x:Name="SearchResultCountComboBox"
                                          Grid.Column="3"
                                          MinWidth="70"
                                          MinHeight="32"
                                          SelectedIndex="1">
                                    <ComboBoxItem Content="10" />
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="50" />
                                </ComboBox>
                            </Grid>

                            <Button x:Name="FetchVideoListButton"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Content="URL読込"
                                    ToolTip="入力したURLから動画情報を取得します。Enterキーでも実行できます。"
                                    MinWidth="130"
                                    MinHeight="32"
                                    Margin="12,0,0,0"
                                    Click="FetchVideoListButton_Click" />
                        </Grid>
                    </GroupBox>

                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button x:Name="SelectAllVideosButton"
                                Content="すべて選択"
                                MinWidth="90"
                                MinHeight="30"
                                Margin="0,0,8,8"
                                Visibility="Collapsed"
                                Click="SelectAllVideosButton_Click" />
                        <Button x:Name="DeselectAllVideosButton"
                                Content="選択解除"
                                MinWidth="100"
                                MinHeight="30"
                                Margin="0,0,8,8"
                                Visibility="Collapsed"
                                Click="DeselectAllVideosButton_Click" />
                        <Button x:Name="InvertVideoSelectionButton"
                                Content="選択反転"
                                MinWidth="120"
                                MinHeight="30"
                                Margin="0,0,16,8"
                                Visibility="Collapsed"
                                Click="InvertVideoSelectionButton_Click" />
                        <Button x:Name="MoveUpButton"
                                Content="上へ"
                                MinWidth="90"
                                MinHeight="30"
                                Margin="0,0,8,8"
                                Visibility="Collapsed"
                                Click="MoveUpButton_Click" />
                        <Button x:Name="MoveDownButton"
                                Content="下へ"
                                MinWidth="90"
                                MinHeight="30"
                                Margin="0,0,8,8"
                                Visibility="Collapsed"
                                Click="MoveDownButton_Click" />
                        <Button x:Name="RemoveButton"
                                Content="削除"
                                MinWidth="90"
                                MinHeight="30"
                                Margin="0,0,16,8"
                                Visibility="Collapsed"
                                Click="RemoveButton_Click" />
                        <Button x:Name="AddSelectedToQueueButton"
                                Content="選択項目をキューへ追加"
                                ToolTip="選択した候補を変換キューに追加します。"
                                MinWidth="160"
                                MinHeight="30"
                                Margin="0,0,0,8"
                                Click="AddSelectedToQueueButton_Click" />
                        <Button x:Name="DownloadSelectedButton"
                                Content="選択項目をDL"
                                MinWidth="140"
                                MinHeight="30"
                                Margin="0,0,8,8"
                                Visibility="Collapsed"
                                Click="DownloadSelectedButton_Click" />
                        <Button x:Name="CancelDownloadButton"
                                Content="キャンセル"
                                IsEnabled="False"
                                MinWidth="80"
                                MinHeight="30"
                                Margin="0,0,8,8"
                                Visibility="Collapsed"
                                Click="CancelDownloadButton_Click" />
                        <Button x:Name="ConvertDownloadedButton"
                                Content="選択項目を変換"
                                MinWidth="150"
                                MinHeight="30"
                                Margin="0,0,0,8"
                                Visibility="Collapsed"
                                Click="ConvertDownloadedButton_Click" />
                    </WrapPanel>

                    <DataGrid x:Name="VideoListDataGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding Order}"
                                                IsReadOnly="True"
                                                Width="50" />
                            <DataGridTemplateColumn Header="サムネ"
                                                    IsReadOnly="True"
                                                    Width="136">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Padding="0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Cursor="Hand"
                                                Focusable="False"
                                                ToolTip="ブラウザで動画を開く"
                                                Click="CandidateThumbnailButton_Click">
                                            <Border Width="120"
                                                    Height="68"
                                                    Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}"
                                                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <Image Source="{Binding ThumbnailImage}"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="タイトル"
                                                Binding="{Binding Title}"
                                                IsReadOnly="True"
                                                Width="*" />
                            <DataGridTextColumn Header="ソース"
                                                Binding="{Binding SourceType}"
                                                IsReadOnly="True"
                                                Width="90" />
                            <DataGridTextColumn Header="長さ"
                                                Binding="{Binding DurationText}"
                                                IsReadOnly="True"
                                                Width="100" />
                            <DataGridTextColumn Header="状態"
                                                Binding="{Binding Status}"
                                                IsReadOnly="True"
                                                Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Expander>

            <GridSplitter x:Name="CandidateQueueGridSplitter"
                          Grid.Row="1"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                          Visibility="Visible" />

            <Expander x:Name="ConversionQueueExpander"
                      Grid.Row="2"
                      Header="変換キュー (0)"
                      IsExpanded="True"
                      Margin="0,0,0,8"
                      AllowDrop="True"
                      DragOver="ConversionQueue_DragOver"
                      Drop="ConversionQueue_Drop"
                      Expanded="ConversionQueueExpander_Expanded"
                      Collapsed="ConversionQueueExpander_Collapsed">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <WrapPanel x:Name="NormalQueueOptionsPanel"
                               Grid.Row="0"
                               Margin="0,0,0,8">
                        <TextBlock Text="実行モード"
                                   ToolTip="キューをどの方法で処理するかを選びます。"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,8" />
                        <ComboBox x:Name="QueueExecutionModeComboBox"
                                  ToolTip="キューをどの方法で処理するかを選びます。"
                                  MinWidth="150"
                                  MinHeight="30"
                                  Margin="0,0,12,8"
                                  SelectedIndex="1"
                                  SelectionChanged="PersistedUiOption_Changed">
                            <ComboBoxItem Content="ダウンロードのみ" Tag="Download Only" />
                            <ComboBoxItem Content="ダウンロードして変換" Tag="Download &amp; Convert" />
                            <ComboBoxItem Content="変換のみ" Tag="Convert Only" />
                            <ComboBoxItem Content="ファイルコピー" Tag="Copy Files" />
                        </ComboBox>
                        <TextBlock Text="出力形式"
                                   ToolTip="変換後のファイル形式や品質を選びます。"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,8" />
                        <ComboBox x:Name="OutputPresetComboBox"
                                  ToolTip="変換後のファイル形式や品質を選びます。"
                                  MinWidth="260"
                                  MinHeight="30"
                                  Margin="0,0,12,8"
                                  SelectionChanged="OutputPresetComboBox_SelectionChanged" />
                        <TextBlock x:Name="AspectModeLabel"
                                   Text="画面比率"
                                   ToolTip="元動画の比率を維持するか、出力サイズに引き伸ばすかを選びます。"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,8" />
                        <ComboBox x:Name="AspectModeComboBox"
                                  ToolTip="元動画の比率を維持するか、出力サイズに引き伸ばすかを選びます。"
                                  MinWidth="210"
                                  MinHeight="30"
                                  Margin="0,0,12,8"
                                  SelectedIndex="0"
                                  SelectionChanged="PersistedUiOption_Changed">
                            <ComboBoxItem Content="比率維持＋余白" Tag="Keep aspect ratio + padding" />
                            <ComboBoxItem Content="引き伸ばし" Tag="Stretch to fit" />
                        </ComboBox>
                        <CheckBox x:Name="KeepOriginalDownloadedFilesCheckBox"
                                  Content="DL元を残す"
                                  ToolTip="ダウンロードして変換する時に、変換前の元ファイルを作業フォルダに残します。"
                                  IsChecked="False"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,8"
                                  Checked="PersistedUiOption_Changed"
                                  Unchecked="PersistedUiOption_Changed" />
                        <TextBlock Text="連番開始"
                                   ToolTip="空欄なら連番なし。1なら001_、16なら016_から連番を付けます。"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,8" />
                        <TextBox x:Name="NumberPrefixTextBox"
                                 Text=""
                                 ToolTip="空欄なら連番なし。1なら001_、16なら016_から連番を付けます。"
                                 Width="64"
                                 MinHeight="30"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,8"
                                 PreviewTextInput="NumberPrefixTextBox_PreviewTextInput" />
                    </WrapPanel>

                    <WrapPanel x:Name="NormalAudioOptionsPanel"
                               Grid.Row="1"
                               Margin="0,0,0,8">
                        <CheckBox x:Name="PeakBoostCheckBox"
                                  Content="音量持ち上げ"
                                  ToolTip="音量ピークが低いファイルだけ、目標ピークまで自動で持ち上げます。すでに大きい音源は下げません。"
                                  IsChecked="False"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,8"
                                  Checked="PeakBoostCheckBox_CheckedChanged"
                                  Unchecked="PeakBoostCheckBox_CheckedChanged" />
                        <TextBlock Text="音声補正"
                                   ToolTip="選択中のキュー項目に、音量ノーマライズなどの音声補正を設定します。"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,8" />
                        <ComboBox x:Name="AudioAdjustmentComboBox"
                                  ToolTip="選択中のキュー項目に、音量ノーマライズなどの音声補正を設定します。"
                                  MinWidth="160"
                                  MinHeight="30"
                                  Margin="0,0,8,8"
                                  SelectedIndex="0"
                                  SelectionChanged="AudioAdjustmentComboBox_SelectionChanged">
                            <ComboBoxItem Content="なし" Tag="Off" />
                            <ComboBoxItem Content="音量ノーマライズ" Tag="Loudness normalize" />
                        </ComboBox>
                        <Button x:Name="ApplyAudioAdjustmentButton"
                                Content="選択項目に適用"
                                ToolTip="選択中のキュー項目に、音量ノーマライズなどの音声補正を設定します。"
                                MinWidth="190"
                                MinHeight="30"
                                Margin="0,0,12,8"
                                Click="ApplyAudioAdjustmentButton_Click" />
                        <TextBlock x:Name="TargetPeakLabel"
                                   Text="目標ピーク"
                                   ToolTip="音量持ち上げ時の目標ピークを指定します。通常は -1.0 dBFS で十分です。"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,8" />
                        <ComboBox x:Name="TargetPeakComboBox"
                                  ToolTip="音量持ち上げ時の目標ピークを指定します。通常は -1.0 dBFS で十分です。"
                                  MinWidth="90"
                                  MinHeight="30"
                                  Margin="0,0,12,8"
                                  SelectedIndex="0"
                                  SelectionChanged="PersistedUiOption_Changed">
                            <ComboBoxItem Content="-1.0 dBFS" />
                            <ComboBoxItem Content="-3.0 dBFS" />
                            <ComboBoxItem Content="-6.0 dBFS" />
                        </ComboBox>
                    </WrapPanel>

                    <WrapPanel x:Name="NormalQueueActionsPanel"
                               Grid.Row="2"
                               Margin="0,0,0,8">
                        <Button x:Name="ConvertQueueButton"
                                Content="実行"
                                ToolTip="現在のキューを上から順に処理します。"
                                MinWidth="110"
                                MinHeight="30"
                                Margin="0,0,8,8"
                                Click="ConvertQueueButton_Click" />
                        <ProgressBar x:Name="QueueProgressBar"
                                     Width="120"
                                     Height="16"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="0"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,8" />
                        <TextBlock x:Name="QueueProgressTextBlock"
                                   Text="準備完了"
                                   MinWidth="86"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,8" />
                        <Button x:Name="RetryFailedQueueButton"
                                Content="失敗分を再実行"
                                ToolTip="失敗したキュー項目だけを再実行します。"
                                MinWidth="110"
                                MinHeight="30"
                                Margin="0,0,8,8"
                                Click="RetryFailedQueueButton_Click" />
                        <Button x:Name="CancelQueueButton"
                                Content="キャンセル"
                                ToolTip="実行中のキュー処理をキャンセルします。"
                                IsEnabled="False"
                                MinWidth="110"
                                MinHeight="30"
                                Margin="0,0,8,8"
                                Click="CancelQueueButton_Click" />
                        <Button x:Name="OpenConvertedFolderButton"
                                Content="出力先..."
                                ToolTip="変換やコピーの出力先フォルダを選択します。"
                                MinWidth="130"
                                MinHeight="30"
                                Margin="0,0,0,8"
                                Click="OutputFolderButton_Click" />
                    </WrapPanel>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <DataGrid x:Name="ConversionQueueDataGrid"
                                  Grid.Column="0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="False"
                                  SelectionMode="Extended"
                                  SelectionUnit="FullRow"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="ConversionQueueDataGrid_PreviewMouseLeftButtonDown"
                                  MouseMove="ConversionQueueDataGrid_MouseMove"
                                  DragOver="ConversionQueueDataGrid_DragOver"
                                  Drop="ConversionQueueDataGrid_Drop"
                                  Sorting="ConversionQueueDataGrid_Sorting"
                                  PreviewKeyDown="ConversionQueueDataGrid_PreviewKeyDown"
                                  KeyDown="ConversionQueueDataGrid_KeyDown"
                                  RowStyle="{StaticResource ConversionQueueRowStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding Order}"
                                                    IsReadOnly="True"
                                                    Width="50" />
                                <DataGridTextColumn Header="ソース"
                                                    Binding="{Binding SourceType}"
                                                    IsReadOnly="True"
                                                    Width="100" />
                                <DataGridTextColumn Header="タイトル / ファイル名"
                                                    Binding="{Binding Title}"
                                                    IsReadOnly="True"
                                                    Width="220" />
                                <DataGridTextColumn Header="ソースパス / URL"
                                                    Binding="{Binding SourcePathOrUrl}"
                                                    IsReadOnly="True"
                                                    Width="*" />
                                <DataGridTextColumn Header="音声補正"
                                                    Binding="{Binding AudioAdjustmentDisplay}"
                                                    IsReadOnly="True"
                                                    Width="100" />
                                <DataGridTemplateColumn Header="状態"
                                                        IsReadOnly="True"
                                                        Width="460"
                                                        MinWidth="360">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="22">
                                                <ProgressBar Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding ProgressPercent}"
                                                             IsIndeterminate="{Binding IsIndeterminate}"
                                                             Opacity="0.45"
                                                             Height="18"
                                                             VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           FontWeight="SemiBold"
                                                           Padding="4,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Button x:Name="QueueMoveUpButton"
                                    Content="↑"
                                    ToolTip="選択した項目を上へ移動します。"
                                    Width="64"
                                    MinHeight="30"
                                    Margin="0,0,0,8"
                                    Click="QueueMoveUpButton_Click" />
                            <Button x:Name="QueueMoveDownButton"
                                    Content="↓"
                                    ToolTip="選択した項目を下へ移動します。"
                                    Width="64"
                                    MinHeight="30"
                                    Margin="0,0,0,8"
                                    Click="QueueMoveDownButton_Click" />
                            <Button x:Name="QueueRemoveButton"
                                    Content="削除"
                                    ToolTip="選択したキュー項目を削除します。Deleteキーでも削除できます。"
                                    Width="64"
                                    MinHeight="30"
                                    Margin="0,0,0,8"
                                    Click="QueueRemoveButton_Click" />
                            <Button x:Name="QueueClearButton"
                                    Content="クリア"
                                    ToolTip="キュー内のすべての項目を削除します。"
                                    Width="64"
                                    MinHeight="30"
                                    Click="QueueClearButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Expander>

            <GridSplitter x:Name="LogGridSplitter"
                          Grid.Row="3"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                          Visibility="Collapsed" />

            <Expander x:Name="LogExpander"
                      Grid.Row="4"
                      Header="ログ"
                      IsExpanded="False"
                      VerticalAlignment="Stretch"
                      Expanded="LogExpander_Expanded"
                      Collapsed="LogExpander_Collapsed">
                <ListBox x:Name="LogListBox"
                         Margin="12"
                         MinHeight="120"
                         VerticalAlignment="Stretch"
                         FontFamily="Consolas"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="ログをコピー"
                                      Click="CopyAllLogsMenuItem_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type services:LogEntry}">
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource LogMarkerStyle}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Level}"
                                           Style="{StaticResource LogLevelStyle}"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Expander>
        </Grid>
    </Grid>
</Window>
