<Window x:Class="NaviMovieMaker.App.UnsavedPlaylistChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="未保存の変更"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24" MinWidth="390">
        <TextBlock Text="プレイリストの変更が保存されていません。&#x0a;保存しますか？"
                   FontSize="14"
                   Margin="0,0,0,22" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" MinWidth="92" Margin="0,0,8,0" IsDefault="True" Click="SaveButton_Click" />
            <Button Content="保存しない" MinWidth="92" Margin="0,0,8,0" Click="DontSaveButton_Click" />
            <Button Content="キャンセル" MinWidth="92" IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
