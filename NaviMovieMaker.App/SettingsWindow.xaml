<Window x:Class="NaviMovieMaker.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定"
        Height="700"
        Width="860"
        MinHeight="500"
        MinWidth="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="フォルダ">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="作業フォルダ"
                               ToolTip="Download OnlyやDL元を残す場合の保存先です。"
                               VerticalAlignment="Center"
                               Margin="0,0,12,10" />
                    <TextBox x:Name="WorkingFolderTextBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             ToolTip="Download OnlyやDL元を残す場合の保存先です。"
                             MinHeight="32"
                             VerticalContentAlignment="Center"
                             Margin="0,0,12,10" />
                    <Button Grid.Row="0"
                            Grid.Column="2"
                            Content="参照..."
                            MinWidth="90"
                            MinHeight="32"
                            Margin="0,0,0,10"
                            Click="BrowseWorkingFolderButton_Click" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="一時フォルダ"
                               ToolTip="変換用に一時的なダウンロードファイルを置く場所です。"
                               VerticalAlignment="Center"
                               Margin="0,0,12,10" />
                    <TextBox x:Name="TemporaryFolderTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             ToolTip="変換用に一時的なダウンロードファイルを置く場所です。"
                             MinHeight="32"
                             VerticalContentAlignment="Center"
                             Margin="0,0,12,10" />
                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Content="参照..."
                            MinWidth="90"
                            MinHeight="32"
                            Margin="0,0,0,10"
                            Click="BrowseTemporaryFolderButton_Click" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="変換済みフォルダ"
                               ToolTip="変換後のファイルを保存する既定フォルダです。"
                               VerticalAlignment="Center"
                               Margin="0,0,12,10" />
                    <TextBox x:Name="ConvertedFolderTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             ToolTip="変換後のファイルを保存する既定フォルダです。"
                             MinHeight="32"
                             VerticalContentAlignment="Center"
                             Margin="0,0,12,10" />
                    <Button Grid.Row="2"
                            Grid.Column="2"
                            Content="参照..."
                            MinWidth="90"
                            MinHeight="32"
                            Margin="0,0,0,10"
                            Click="BrowseConvertedFolderButton_Click" />

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="ローカル動画フォルダ"
                               ToolTip="ローカルファイル選択時の初期表示フォルダです。"
                               VerticalAlignment="Center"
                               Margin="0,0,12,10" />
                    <TextBox x:Name="LocalVideoFolderTextBox"
                             Grid.Row="3"
                             Grid.Column="1"
                             ToolTip="ローカルファイル選択時の初期表示フォルダです。"
                             MinHeight="32"
                             VerticalContentAlignment="Center"
                             Margin="0,0,12,10" />
                    <Button Grid.Row="3"
                            Grid.Column="2"
                            Content="参照..."
                            MinWidth="90"
                            MinHeight="32"
                            Margin="0,0,0,10"
                            Click="BrowseLocalVideoFolderButton_Click" />

                    <TextBlock Grid.Row="4"
                               Grid.ColumnSpan="3"
                               Text="設定の保存時に、存在しないフォルダは自動作成されます。"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Bottom" />
                </Grid>
            </TabItem>

            <TabItem Header="出力 / 変換">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="CreatePresetSubfolderCheckBox"
                              Grid.Row="0"
                              Grid.ColumnSpan="3"
                              Content="出力形式ごとにサブフォルダを作成"
                              ToolTip="出力形式ごとのフォルダに分けて保存します。"
                              VerticalAlignment="Top"
                              Margin="0,0,0,14" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="起動時レイアウト"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <ComboBox x:Name="StartupLayoutComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              MinHeight="32"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="キュー中心" Tag="QueueFocus" />
                        <ComboBoxItem Content="標準" Tag="Standard" />
                        <ComboBoxItem Content="ブラウザ中心" Tag="BrowserFocus" />
                        <ComboBoxItem Content="前回の状態を復元" Tag="LastUsed" />
                    </ComboBox>
                </Grid>
            </TabItem>

            <TabItem Header="ダウンロード">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="ダウンロード品質"
                               ToolTip="yt-dlpで取得する元ファイルの品質を選びます。最終的な変換品質とは別です。"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <ComboBox x:Name="DownloadProfileComboBox"
                              Grid.Row="0"
                              Grid.Column="1"
                              ToolTip="yt-dlpで取得する元ファイルの品質を選びます。最終的な変換品質とは別です。"
                              MinHeight="32"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Id" />
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="3"
                               Text="ダウンロード品質は yt-dlp に要求する元動画の品質です。最終的な出力形式とサイズは出力形式で決まります。"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0" />
                </Grid>
            </TabItem>

            <TabItem Header="外部ツール">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="yt-dlp.exe"
                               VerticalAlignment="Center"
                               Margin="0,0,12,10" />
                    <TextBox x:Name="YtDlpPathTextBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             MinHeight="32"
                             VerticalContentAlignment="Center"
                             Margin="0,0,12,10" />
                    <Button Grid.Row="0"
                            Grid.Column="2"
                            Content="参照..."
                            MinWidth="90"
                            MinHeight="32"
                            Margin="0,0,0,10"
                            Click="BrowseYtDlpPathButton_Click" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="ffmpeg.exe"
                               VerticalAlignment="Center"
                               Margin="0,0,12,10" />
                    <TextBox x:Name="FfmpegPathTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             MinHeight="32"
                             VerticalContentAlignment="Center"
                             Margin="0,0,12,10" />
                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Content="参照..."
                            MinWidth="90"
                            MinHeight="32"
                            Margin="0,0,0,10"
                            Click="BrowseFfmpegPathButton_Click" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="ffprobe.exe"
                               VerticalAlignment="Center"
                               Margin="0,0,12,10" />
                    <TextBox x:Name="FfprobePathTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             MinHeight="32"
                             VerticalContentAlignment="Center"
                             Margin="0,0,12,10" />
                    <Button Grid.Row="2"
                            Grid.Column="2"
                            Content="参照..."
                            MinWidth="90"
                            MinHeight="32"
                            Margin="0,0,0,10"
                            Click="BrowseFfprobePathButton_Click" />

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="mpv.exe"
                               VerticalAlignment="Center"
                               Margin="0,0,12,10" />
                    <TextBox x:Name="MpvPathTextBox"
                             Grid.Row="3"
                             Grid.Column="1"
                             MinHeight="32"
                             VerticalContentAlignment="Center"
                             Margin="0,0,12,10" />
                    <Button Grid.Row="3"
                            Grid.Column="2"
                            Content="参照..."
                            MinWidth="90"
                            MinHeight="32"
                            Margin="0,0,0,10"
                            Click="BrowseMpvPathButton_Click" />

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="yt-dlp取得URL"
                               VerticalAlignment="Center"
                               Margin="0,0,12,10" />
                    <TextBox x:Name="YtDlpDownloadUrlTextBox"
                             Grid.Row="4"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             MinHeight="32"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,10" />

                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               Text="FFmpeg取得URL"
                               VerticalAlignment="Center"
                               Margin="0,0,12,10" />
                    <TextBox x:Name="FfmpegDownloadUrlTextBox"
                             Grid.Row="5"
                             Grid.Column="1"
                             Grid.ColumnSpan="2"
                             MinHeight="32"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,10" />

                    <TextBlock Grid.Row="6"
                               Grid.ColumnSpan="3"
                               Text="実行ファイル欄が空の場合は tools フォルダ、次に PATH から検出します。mpv は自動取得されません。取得URLは通常変更不要です。"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Top" />
                </Grid>
            </TabItem>

            <TabItem Header="出力形式">
                <GroupBox Header="表示する出力形式"
                          ToolTip="メイン画面の出力形式一覧に表示するプリセットを選びます。"
                          Margin="14">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="非表示"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Text="表示"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />

                        <ListBox x:Name="HiddenPresetsListBox"
                                 Grid.Row="1"
                                 Grid.Column="0"
                                 DisplayMemberPath="DisplayName"
                                 SelectionMode="Extended" />

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="12,0">
                            <Button Content="-&gt;"
                                    MinWidth="60"
                                    MinHeight="30"
                                    Margin="0,0,0,8"
                                    Click="ShowPresetButton_Click" />
                            <Button Content="&lt;-"
                                    MinWidth="60"
                                    MinHeight="30"
                                    Click="HidePresetButton_Click" />
                        </StackPanel>

                        <ListBox x:Name="VisiblePresetsListBox"
                                 Grid.Row="1"
                                 Grid.Column="2"
                                 DisplayMemberPath="DisplayName"
                                 SelectionMode="Extended" />

                        <StackPanel Grid.Row="1"
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <Button Content="上へ"
                                    MinWidth="70"
                                    MinHeight="30"
                                    Margin="0,0,0,8"
                                    Click="MoveVisiblePresetUpButton_Click" />
                            <Button Content="下へ"
                                    MinWidth="70"
                                    MinHeight="30"
                                    Click="MoveVisiblePresetDownButton_Click" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="保存"
                    MinWidth="90"
                    MinHeight="32"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click" />
            <Button Content="キャンセル"
                    MinWidth="90"
                    MinHeight="32"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
