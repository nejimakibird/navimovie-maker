<Window x:Class="NaviMovieMaker.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="700"
        Width="860"
        MinHeight="500"
        MinWidth="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Working Folder"
                   VerticalAlignment="Center"
                   Margin="0,0,12,10" />
        <TextBox x:Name="WorkingFolderTextBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 MinHeight="32"
                 VerticalContentAlignment="Center"
                 Margin="0,0,12,10" />
        <Button Grid.Row="0"
                Grid.Column="2"
                Content="Browse..."
                MinWidth="90"
                MinHeight="32"
                Margin="0,0,0,10"
                Click="BrowseWorkingFolderButton_Click" />

        <TextBlock Grid.Row="1"
                   Grid.Column="0"
                   Text="Temporary Folder"
                   VerticalAlignment="Center"
                   Margin="0,0,12,10" />
        <TextBox x:Name="TemporaryFolderTextBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 MinHeight="32"
                 VerticalContentAlignment="Center"
                 Margin="0,0,12,10" />
        <Button Grid.Row="1"
                Grid.Column="2"
                Content="Browse..."
                MinWidth="90"
                MinHeight="32"
                Margin="0,0,0,10"
                Click="BrowseTemporaryFolderButton_Click" />

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Converted Folder"
                   VerticalAlignment="Center"
                   Margin="0,0,12,10" />
        <TextBox x:Name="ConvertedFolderTextBox"
                 Grid.Row="2"
                 Grid.Column="1"
                 MinHeight="32"
                 VerticalContentAlignment="Center"
                 Margin="0,0,12,10" />
        <Button Grid.Row="2"
                Grid.Column="2"
                Content="Browse..."
                MinWidth="90"
                MinHeight="32"
                Margin="0,0,0,10"
                Click="BrowseConvertedFolderButton_Click" />

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   Text="Local Video Folder"
                   VerticalAlignment="Center"
                   Margin="0,0,12,10" />
        <TextBox x:Name="LocalVideoFolderTextBox"
                 Grid.Row="3"
                 Grid.Column="1"
                 MinHeight="32"
                 VerticalContentAlignment="Center"
                 Margin="0,0,12,10" />
        <Button Grid.Row="3"
                Grid.Column="2"
                Content="Browse..."
                MinWidth="90"
                MinHeight="32"
                Margin="0,0,0,10"
                Click="BrowseLocalVideoFolderButton_Click" />

        <CheckBox x:Name="CreatePresetSubfolderCheckBox"
                  Grid.Row="4"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Content="Create subfolder per output preset"
                  VerticalAlignment="Center"
                  Margin="0,0,0,10" />

        <GroupBox Grid.Row="5"
                  Grid.ColumnSpan="3"
                  Header="Visible Output Presets"
                  Margin="0,0,0,10">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="220" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Hidden presets"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Visible presets"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6" />

                <ListBox x:Name="HiddenPresetsListBox"
                         Grid.Row="1"
                         Grid.Column="0"
                         DisplayMemberPath="DisplayName"
                         SelectionMode="Extended" />

                <StackPanel Grid.Row="1"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="12,0">
                    <Button Content="-&gt;"
                            MinWidth="60"
                            MinHeight="30"
                            Margin="0,0,0,8"
                            Click="ShowPresetButton_Click" />
                    <Button Content="&lt;-"
                            MinWidth="60"
                            MinHeight="30"
                            Click="HidePresetButton_Click" />
                </StackPanel>

                <ListBox x:Name="VisiblePresetsListBox"
                         Grid.Row="1"
                         Grid.Column="2"
                         DisplayMemberPath="DisplayName"
                         SelectionMode="Extended" />

                <StackPanel Grid.Row="1"
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Button Content="Up"
                            MinWidth="70"
                            MinHeight="30"
                            Margin="0,0,0,8"
                            Click="MoveVisiblePresetUpButton_Click" />
                    <Button Content="Down"
                            MinWidth="70"
                            MinHeight="30"
                            Click="MoveVisiblePresetDownButton_Click" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="6"
                   Grid.ColumnSpan="3"
                   Text="Folders are created when settings are saved if they do not already exist."
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="7"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Save"
                    MinWidth="90"
                    MinHeight="32"
                    Margin="0,0,8,0"
                    Click="SaveButton_Click" />
            <Button Content="Cancel"
                    MinWidth="90"
                    MinHeight="32"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
